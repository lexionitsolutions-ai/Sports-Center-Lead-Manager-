# Server only. Copy to .env.agent. Never use VITE_ for these secrets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
EVOLUTION_URL=https://your-evolution-server.example.com
# Instance token, NOT GLOBAL_API_KEY. Copy the instance ID and token from Evolution Manager.
EVOLUTION_INSTANCE_TOKEN=
EVOLUTION_INSTANCE_ID=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_WEBHOOK_SECRET=
# Keep false during configuration. Set true only for the verified pilot.
AGENT_SEND_ENABLED=false
PORT=8787
# Optional: a telephony bridge must verify its provider signature and sign our normalized event.
TELEPHONY_WEBHOOK_SECRET=
# Used by compose.agent.yaml only. Generate distinct random hex values for each.
EVOLUTION_GLOBAL_API_KEY=
EVOLUTION_POSTGRES_PASSWORD=
